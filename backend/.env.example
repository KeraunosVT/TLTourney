# backend/.env.example — the TEMPLATE. Copy to backend/.env and fill in.
#
# ⚠️  NEVER PUT REAL SECRETS IN THIS FILE.
# This one is committed to git; backend/.env is not. A service key or client
# secret pasted here goes to GitHub the moment anyone pushes. Real values belong
# in backend/.env, which .gitignore excludes.
#
# ⚠️  Everything below belongs to the TOURNAMENT's own Discord server and its own
# Supabase project. Do NOT copy anything from the Gear-Gap guild app: its role
# IDs mean nothing in this server and its redirect URI points at a different
# site.

# ── Discord application (TOURNAMENT server) ─────────────────────────────────
# https://discord.com/developers/applications → New Application
# OAuth2 → Redirects: add EVERY redirect URI you will use — local and live.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Must match a redirect registered on that application EXACTLY — scheme, host,
# port and path, no trailing slash.
#   local : http://localhost:3000/api/auth/discord/callback
#   live  : https://tnltourneystats.com/api/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# The tournament Discord server's ID. Developer Mode → right-click the server →
# Copy Server ID. Not a secret, but it is deployment-specific.
DISCORD_GUILD_ID=

# ── Roles, in the tournament server ─────────────────────────────────────────
# Comma-separated role IDs.
#
# ⚠️  THE GATE — checked BEFORE a login is allowed.
# Who may sign in at all. EMPTY = any member of the server can, which is what
# you want for an open tournament. LEAVE IT EMPTY unless you deliberately want
# to shut most of the server out.
#
# NEVER put DISCORD_VERIFIED_ROLE_ID (below) in here. That role is granted only
# AFTER a login succeeds, so making it the thing that PERMITS a login locks out
# every single person, permanently, including you. The app refuses to start
# quietly if you do — it shouts, and /api/auth/config reports role_deadlock.
DISCORD_ALLOWED_ROLE_IDS=

# Who runs it: the approval queue and tournament settings. EMPTY = nobody, and
# the queue is unreachable. Set this before you need it.
# Once the app is running you can read the role IDs at /api/organizer/roles.
DISCORD_ADMIN_ROLE_IDS=

# ── THE GRANT — applied AFTER a login succeeds ──────────────────────────────
# The opposite of DISCORD_ALLOWED_ROLE_IDS above, and one word apart in name:
# that one decides who gets IN, this one decides what they GET. Setting both to
# the same role is a deadlock nobody can sign in through.
#
# A single role ID, handed to anyone who completes Discord login on the site.
# Re-applied on every login, so a role removed by hand comes back next visit.
# EMPTY = the feature is off.
#
# This is the ONLY setting that WRITES to Discord, and it needs two things that
# nothing else here does:
#   1. the bot must hold the "Manage Roles" permission, and
#   2. the bot's own role must sit ABOVE this role in Server Settings → Roles.
# Discord reports a failure of (2) as "Missing Permissions", identical to (1),
# so if grants fail check the ordering before you go looking at permissions.
# Verify both at /api/organizer/hierarchy once the app is running.
DISCORD_VERIFIED_ROLE_ID=

# ── Bot (optional, but do set it) ───────────────────────────────────────────
# Without a bot token the app still works. What you lose:
#   · sessions are never re-checked, so someone who leaves the server keeps
#     access until their 7-day cookie expires
#   · approval and rejection DMs don't send
# Bot → Reset Token. Invite it to the tournament server with the `bot` scope.
DISCORD_BOT_TOKEN=

# ── Database (the TLTourney Supabase project) ───────────────────────────────
# Project Settings → API. The SERVICE key, not the anon key — it bypasses row
# level security, so it must never reach the browser and never reach git.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Session ─────────────────────────────────────────────────────────────────
# Signs the session cookie. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out, which is also how you revoke every session.
JWT_SECRET=

# ── Environment ─────────────────────────────────────────────────────────────
PORT=3000

# ⚠️  MUST be `production` on the live site. It is what turns on `secure` session
# cookies and `trust proxy`. Left at `development` behind HTTPS, the login
# cookie is issued without the Secure flag and the rate limiter keys every
# request to the proxy's IP instead of the caller's.
NODE_ENV=development

# Where Discord sends people after login, and where failed logins land.
#   local : /
#   live  : https://tnltourneystats.com
APP_URL=/

# How long a session may go without being re-checked against Discord.
SESSION_REVERIFY_MINUTES=60

# Local dev with two separate servers only. The Vite proxy makes dev
# same-origin, so you normally do NOT need this — and production serves the
# frontend from the same process, so it must stay EMPTY there.
CORS_ORIGINS=

# ── Scoreboard reading ──────────────────────────────────────────────────────
# Gemini turns an end-of-match screenshot into scoreboard rows. Without it the
# upload still accepts a CSV — only the screenshot path needs a key.
GEMINI_API_KEY=
# Model names churn. Swappable without a code change.
GEMINI_MODEL=gemini-2.5-flash
# The weapon-icon reference sent alongside every screenshot. Defaults to
# backend/assets/weapon-legend.png; set this only to point somewhere else.
WEAPON_LEGEND_PATH=
